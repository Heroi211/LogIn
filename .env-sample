# =============================================================================
# Backend Starter — Identity & Access
# Copie para .env:  cp .env-sample .env
# =============================================================================

# --- Perfil da aplicação ---
# development | staging | production
APP_ENV=development

# --- Identidade do projeto (rebrand por projeto) ---
PROJECT_NAME=LogIn API
PROJECT_VERSION=/v1
APP_BRAND_NAME=Meu Projeto
EMAIL_FROM_NAME=
EMAIL_SIGNATURE=

# --- JWT / segurança ---
SECRET=dev-secret-local-minimo-32-caracteres!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SIGNUP_PUBLIC=true
TIMEZONE=America/Sao_Paulo

# CORS (lista separada por vírgula ou * para qualquer origem)
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Bloqueio por tentativas de login e recuperação de senha
LOGIN_MAX_FAILED_ATTEMPTS=3
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_WINDOW_DAYS=30
PASSWORD_MIN_LENGTH=8

# Rate limit por IP (requisições por minuto)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=3
PERMISSION_CACHE_TTL_SECONDS=60

# --- Observabilidade (Fase C) ---
LOG_FORMAT=text
METRICS_ENABLED=true

# --- Frontend (links em e-mails) ---
FRONTEND_URL=http://127.0.0.1:3000

# --- Banco de dados ---
# Schema + dados iniciais: init_db/database.sql (Docker aplica no primeiro up)
DATABASE_USER=hero
DATABASE_PASS=change-me
DATABASE_SERVER=localhost
DATABASE_PORT=5432
DATABASE_NAME=login

# --- Docker Compose (make up / make dev) ---
# DATABASE_SERVER=db_login

# --- pgAdmin (somente docker-compose.dev.yaml) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# --- SMTP (recuperação de senha — opcional em dev) ---
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Logging ---
DEBUG=false
LOG_LEVEL=
LOG_HTTP_REQUESTS=true
LOG_HTTP_REQUESTS_FILE=false
PATH_API_REQUEST_LOGS=logs/api_requests
LOG_HTTP_REQUESTS_MAX_BYTES=5242880
LOG_HTTP_REQUESTS_BACKUP_COUNT=5

# =============================================================================
# Perfis sugeridos
# =============================================================================
# development: APP_ENV=development DEBUG=true
# staging:     APP_ENV=staging
# production:  APP_ENV=production + SECRET forte

# =============================================================================
# Dados iniciais (init_db/database.sql)
# Admin padrão: CPF 00000000000 | senha Admin@123456 | admin@example.com
# Reset total do banco: make docker-fresh (apaga volume pgdata)
