# =============================================================================
# Gestao Tickets — stack Docker produção (make up)
# Uso:  cp .env-sample .env && make up
# PostgreSQL roda SOMENTE no container database_gt — não instale Postgres local.
# Hot reload da API: make dev (docker-compose.dev.yaml — override separado)
# =============================================================================

# --- CONFIG ---
APP_ENV=production

PROJECT_NAME=Gestao Tickets
PROJECT_VERSION=/v1
APP_BRAND_NAME=Gestao Tickets
EMAIL_FROM_NAME=
EMAIL_SIGNATURE=

# --- JWT ---
SECRET=6j74F3SRxbpBox3BYLdWKCcyKU3uBXj8
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SIGNUP_PUBLIC=true
TIMEZONE=America/Sao_Paulo

# --- Frontend ---
FRONTEND_URL=http://127.0.0.1:3000

# --- CORS e segurança ---
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
LOGIN_MAX_FAILED_ATTEMPTS=3
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_WINDOW_DAYS=30
PASSWORD_MIN_LENGTH=8
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=3
PERMISSION_CACHE_TTL_SECONDS=60

# --- DATABASE (container Docker — serviço database_gt no compose) ---
DATABASE_USER=hero
DATABASE_PASS=280387
DATABASE_SERVER=database_gt
DATABASE_PORT=5432
DATABASE_NAME=login

# --- pgAdmin (sobe sempre com make up — http://localhost:5050) ---
PGADMIN_EMAIL=gabriel_s4@hotmail.com
PGADMIN_PASSWORD=280387

# --- SMTP (recuperação de senha) ---
SMTP_USER=gabrieldrumond211@gmail.com
SMTP_PASSWORD=jggp jojt pcop pjub
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- LOGGING ---
DEBUG=false
LOG_LEVEL=
LOG_HTTP_REQUESTS=true
LOG_HTTP_REQUESTS_FILE=false
PATH_API_REQUEST_LOGS=logs/api_requests
LOG_HTTP_REQUESTS_MAX_BYTES=5242880
LOG_HTTP_REQUESTS_BACKUP_COUNT=5

# --- Observabilidade ---
LOG_FORMAT=json
METRICS_ENABLED=true

# =============================================================================
# Subir (produção local via Docker)
#   make up           → API + PostgreSQL + pgAdmin
#   make health       → valida /health e /health/ready
#   make docker-fresh → recria volume e reaplica init_db/database.sql
#
# URLs
#   API/Swagger  http://localhost:8000/docs
#   pgAdmin      http://localhost:5050  (login: PGADMIN_EMAIL / PGADMIN_PASSWORD)
#   Servidor DB no pgAdmin: host database_gt, porta 5432, user/pass do DATABASE_*
#
# Admin seed (init_db/database.sql)
#   CPF 00000000000 | senha Admin@123456 | admin@example.com
# =============================================================================
