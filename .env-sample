#CONFIG
PROJECT_NAME=LogIn API
PROJECT_VERSION=/v1
ENVIRONMENT=production

# Valores: development | production
# development → repositórios mockados (sem PostgreSQL)
# production  → PostgreSQL via SQLAlchemy
# ALLOW_MOCK_REPOS=true — permite mock com DATABASE_SERVER remoto (apenas dev/staging)
ALLOW_MOCK_REPOS=false

#JWT (mín. 32 caracteres em production)
SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TIMEZONE=America/Sao_Paulo

#FRONTEND / CORS
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

#SESSÃO SERVER-SIDE
SESSION_EXPIRE_DAYS=7
SESSION_COOKIE_NAME=session_token
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

#API KEY
API_KEY_HEADER=X-API-Key

#SEGURANÇA — login
MAX_FAILED_LOGIN_ATTEMPTS=3

#OAUTH GOOGLE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

#DATABASE — Docker Compose (make docker-fresh)
DATABASE_USER=hero
DATABASE_PASS=changeme
DATABASE_SERVER=db_login
DATABASE_PORT=5432
DATABASE_NAME=login

# pgAdmin (docker compose)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeme

#LOGGING
DEBUG=false
LOG_HTTP_REQUESTS=true
LOG_HTTP_REQUESTS_FILE=true
PATH_API_REQUEST_LOGS=logs/api_requests
LOG_HTTP_REQUESTS_MAX_BYTES=5242880
LOG_HTTP_REQUESTS_BACKUP_COUNT=5
PATH_MAINTENANCE_REPORTS=reports/maintenance

#SMTP (recuperação de senha)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Cod3Bit Dev Team
SMTP_USE_SSL=true
FRONTEND_RESET_PASSWORD_URL=http://127.0.0.1:3000/resetpassword

#TWILIO / WHATSAPP
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_ADMIN_PHONE=
